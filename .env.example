# ===== CORE CONFIGURATION =====
NODE_ENV=production
PORT=5005

# ===== DATABASE POOL (CRITICAL FOR concurrency) =====
# Increased from 40/20/200 to 100/50/500 respectively
DB_POOL_LIMIT=100
DB_POOL_MAX_IDLE=50
DB_QUEUE_LIMIT=500
DB_PORT=3306
DB_HOST=localhost
DB_USER=root
DB_NAME=jaivarahi
DB_PASSWORD=Admin@123

# ===== RATE LIMITING =====
# Production: 200 submissions/IP/15min (was 120)
PUBLIC_SUB_RATE_LIMIT_MAX=200
# Development: 1000 submissions/IP/15min (was unrestricted at 2000)
DEV_SUB_RATE_LIMIT_MAX=1000
# Admin authenticated: 500/IP/15min (new env var)
ADMIN_SUB_RATE_LIMIT_MAX=500

# ===== REDIS (OPTIONAL - for distributed SSE) =====
# Uncomment and set if using Redis for cross-instance SSE
# REDIS_URL=redis://localhost:6379

# ===== SECURITY & SECRETS =====
ADMIN_JWT_SECRET=your_strong_random_jwt_secret_here
ADMIN_EMAIL=admin@jaivarahi.org
ADMIN_PASSWORD_HASH=$2a$10$8znwiEbL5deBPQHIp7r.9OPoqs1txKo1iwCBVW1aO4TSKG0xNAx66

# ===== PAYMENT GATEWAY (RAZORPAY) =====
VITE_RAZORPAY_KEY=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ===== DOMAINS & CORS =====
FRONTEND_ORIGIN=https://jaivarahi.org,https://www.jaivarahi.org
CORS_ORIGINS=https://jaivarahi.org,https://www.jaivarahi.org,https://admin.jaivarahi.org
VITE_BACKEND_URL=https://jaivarahi.org

# ===== HEALTH CHECK & LOGS =====
# Set to "1" to enable DB ping in health check
DB_HEALTH_CHECK=1

# ===== TEMPLE SERVICE & CONTACTS =====
TEMPLE_PHONE=+919092878389
TEMPLE_ADDRESS=Arumparuthi, Katpadi, Vellore – 632106