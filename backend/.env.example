# ============================================================
# JAI VARAHI PEEDAM — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# INSTRUCTIONS: Copy this file to `.env` and populate with actual credentials.
# NEVER commit the `.env` file to version control.

# Server Settings
PORT=5000
NODE_ENV=development
ADMIN_EMAIL=admin@jaivarahi.org
ADMIN_PASSWORD_HASH=
FRONTEND_ORIGIN=https://jaivarahi.org
CORS_ORIGINS=https://jaivarahi.org,https://www.jaivarahi.org

# Database Configuration (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jaivarahi
DB_POOL_LIMIT=25

# JWT Secret for Admin Sessions (Generate using: openssl rand -base64 48)
ADMIN_JWT_SECRET=

# Razorpay Payment Gateway Credentials
VITE_RAZORPAY_KEY=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio SMS Service Credentials
TWILIO_SID=
TWILIO_AUTH_KEY=
TWILIO_FROM=

# Temple Contact Info
TEMPLE_PHONE=+919092878389
TEMPLE_ADDRESS="Arumparuthi, Katpadi, Vellore – 632106"
